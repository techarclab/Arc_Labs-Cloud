# Builds the web console and serves it with nginx on port 80 (published as 3002 by docker-compose).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/ingestion-worker/package.json apps/ingestion-worker/
COPY apps/console/package.json apps/console/
COPY tools/device-simulator/package.json tools/device-simulator/
RUN npm ci --no-audit --no-fund
COPY apps/console apps/console
# The console serves the ArcCloud Arduino library zip at /downloads (packed during the build).
COPY tools/pack-arduino-library.mjs tools/
COPY firmware/arduino-library firmware/arduino-library
RUN npm run build -w @arc/console

FROM nginx:1.28-alpine
# The nginx image lags behind Alpine's security fixes (Trivy, 2026-11-11: OpenSSL, curl, expat, brotli, c-ares on
# Alpine 3.23.3). Take the fixed packages at build time; CI's Trivy gate fails the build if a fixable HIGH remains.
RUN apk upgrade --no-cache
COPY infra/console/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/console/dist /usr/share/nginx/html
