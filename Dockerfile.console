# Builds the web console and serves it with nginx on port 8080 as the unprivileged `nginx` user
# (published as 3002 by docker-compose; Caddy proxies to console:8080 on the VM).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/ingestion-worker/package.json apps/ingestion-worker/
COPY apps/console/package.json apps/console/
COPY tools/device-simulator/package.json tools/device-simulator/
RUN npm ci --no-audit --no-fund
COPY apps/console apps/console
# The console serves the ArcCloud Arduino library zip at /downloads (packed during the build).
COPY tools/pack-arduino-library.mjs tools/
COPY firmware/arduino-library firmware/arduino-library
RUN npm run build -w @arc/console

FROM nginx:1.30-alpine
# nginx 1.30 (stable line): the 1.28 image carried nginx 1.28.3-r1 with 5 HIGH fixed in later package revisions.
# The nginx image also lags behind Alpine's security fixes (Trivy, 2026-11-11: OpenSSL, curl, expat, brotli, c-ares on
# Alpine 3.23.3). Take the fixed packages at build time; CI's Trivy gate fails the build if a fixable HIGH remains.
RUN apk upgrade --no-cache
# Non-root: no `user` directive, the pid file in /tmp, and the nginx user owning its cache (temp files) directory.
RUN sed -i -e '/^user /d' -e 's#^pid .*#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
 && chown -R nginx:nginx /var/cache/nginx
COPY infra/console/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/console/dist /usr/share/nginx/html
USER nginx
EXPOSE 8080
