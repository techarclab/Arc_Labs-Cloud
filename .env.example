# Copy to .env (or run: bash infra/scripts/bootstrap.sh to generate random secrets).
# Never commit .env.

# --- Database ---
POSTGRES_USER=arc
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=arc_cloud

# --- API ---
JWT_SECRET=__JWT_SECRET__
# Access tokens last 15 minutes; the console renews them with a refresh cookie (a session lasts SESSION_DAYS).
JWT_TTL_SECONDS=900
SESSION_DAYS=30
# The refresh cookie is Secure (HTTPS only) in production; plain http on localhost needs false.
SESSION_COOKIE_SECURE=false
# strict when the console and API share a site; none (with Secure) when they are on different sites.
SESSION_COOKIE_SAMESITE=strict
# Google Cloud OAuth Web client ID (public; configure the same ID in Google Cloud Console and here).
GOOGLE_CLIENT_ID=
# Set to false once your team accounts exist.
ALLOW_SIGNUP=true
CORS_ORIGINS=http://localhost:3002

# --- Broker <-> API (private) ---
INTERNAL_HOOK_TOKEN=__INTERNAL_HOOK_TOKEN__
MQTT_SERVICE_USERNAME=arc-ingest
MQTT_SERVICE_PASSWORD=__MQTT_SERVICE_PASSWORD__

# What provisioned devices are told to connect to.
# For an ESP32 on your Wi-Fi, use your computer's LAN IP (and regenerate certs with HOST_IP).
MQTT_PUBLIC_HOST=localhost
MQTT_PUBLIC_PORT=8883
# Base URL devices use for the HTTP API (ThingSpeak-style /api/v1/update). Use your LAN IP for an ESP32.
HTTP_PUBLIC_URL=http://localhost:3000

# Accept device keys in the URL (?api_key=…, ThingSpeak style). Set false in production once firmware
# sends "Authorization: Bearer KEY" (URLs end up in proxy and load-balancer logs).
DEVICE_KEY_IN_QUERY=true

# --- Broker management API (private) ---
# Lets the API disconnect a device the moment it is revoked, rotated, suspended or retired.
EMQX_API_KEY=arc-api
EMQX_API_SECRET=__EMQX_API_SECRET__

# --- Ingestion worker ---
DEVICE_RATE_PER_SEC=5
DEVICE_BURST=20
