# TLS for the ARC Cloud server. Certificates come from Let's Encrypt only, with RSA keys, so the chain ends at
# ISRG Root X1 — a root the device firmware pins (firmware/esp32-arduino/*/arc_roots.h). Changing the CA or key
# type can break every device's TLS check: keep these two lines.
{
	email {$ACME_EMAIL}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	key_type rsa2048
}

{$API_HOST} {
	encode gzip
	reverse_proxy api:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

# This site exists so Caddy obtains and renews the certificate EMQX serves on :8883
# (copied by arc-cert-sync). Nothing is served over HTTPS here.
{$MQTT_HOST} {
	respond "ARC Cloud MQTT broker: connect with MQTT over TLS on port 8883." 404
}
